# Copy to `.env` and fill in. `.env` is gitignored.
#
# Prisma 7 does not load `.env` implicitly — `prisma.config.ts` imports
# `dotenv/config` for the CLI, and Next.js loads `.env` for the app itself.
#
# Both URLs point at the same Neon *development* branch. The production branch's
# URLs belong in the deployment environment, never in this file.

# Pooled endpoint — used at runtime by the driver adapter in `src/lib/prisma.ts`.
# Host contains `-pooler`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Unpooled endpoint — used by the Prisma CLI for migrations, which need a
# session-level connection the pooler cannot provide. Same host without `-pooler`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (NextAuth v5) -------------------------------------------------
#
# Auth.js picks these up by name; nothing passes them explicitly.

# Signs and encrypts the session JWT. Generate one with `npx auth secret`.
AUTH_SECRET=""

# GitHub OAuth app credentials. Create the app under Settings → Developer
# settings → OAuth Apps, with the authorization callback URL set to
# `http://localhost:3000/api/auth/callback/github` for local development.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Absolute origin, used to build the link inside verification emails — mail
# cannot follow a relative URL the way an in-app redirect can. Optional in local
# development, where it falls back to `http://localhost:3000`; on Vercel,
# `VERCEL_URL` covers preview deployments automatically.
AUTH_URL=""

# --- Email (Resend) --------------------------------------------------------

# Sends the verification link on registration. Create a key at
# https://resend.com/api-keys.
RESEND_API_KEY=""

# Address the mail is sent from. Optional — defaults to Resend's shared sandbox
# sender `onboarding@resend.dev`, which needs no DNS setup but only delivers to
# the address that owns the Resend account and to `*@resend.dev` test inboxes.
# Set this to an address on a domain verified in Resend before real users sign
# up, or their verification mail will silently go nowhere.
EMAIL_FROM=""
