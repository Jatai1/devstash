# Copy to `.env` and fill in. `.env` is gitignored.
#
# Prisma 7 does not load `.env` implicitly — `prisma.config.ts` imports
# `dotenv/config` for the CLI, and Next.js loads `.env` for the app itself.
#
# Both URLs point at the same Neon *development* branch. The production branch's
# URLs belong in the deployment environment, never in this file.

# Pooled endpoint — used at runtime by the driver adapter in `src/lib/prisma.ts`.
# Host contains `-pooler`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Unpooled endpoint — used by the Prisma CLI for migrations, which need a
# session-level connection the pooler cannot provide. Same host without `-pooler`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"
